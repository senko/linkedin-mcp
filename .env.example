# Required: OAuth access token with the r_dma_portability_self_serve scope.
# Generate it at https://www.linkedin.com/developers/tools/oauth/token-generator
LINKEDIN_ACCESS_TOKEN=

# Optional: seconds to keep snapshot data in memory (default 3600, 0 disables caching)
LINKEDIN_CACHE_TTL=
# Optional: HTTP request timeout in seconds (default 30)
LINKEDIN_TIMEOUT=
